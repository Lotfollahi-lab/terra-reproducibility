#!/bin/bash
# Post-hoc Harmony on a saved embedding (run_harmony.py), e.g. TERRA.
# Submit from this folder (logs and config are resolved relative to it):
#   METHOD=terra DATASET=chl59-8b_1p bsub -q normal -n 8 -M 128GB \
#       -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]" -W 12:00 < run_harmony.lsf
#
#BSUB -G team361
#BSUB -J human_niche_harmony
#BSUB -o ../../../artifacts/benchmarking/human/logs/harmony_%J.out
#BSUB -e ../../../artifacts/benchmarking/human/logs/harmony_%J.err
set -euo pipefail
: "${METHOD:?Set METHOD (e.g. terra | terra_hvg)}"
: "${DATASET:?Set DATASET}"
source "$LS_SUBCWD/config.sh"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}

echo "Host: $(hostname) | Job: $LSB_JOBID | Method: $METHOD | Dataset: $DATASET"
"$BENCH_DIR/job_wrapper.sh" "$PYTHON_BANKSY" run_harmony.py --method "$METHOD" --dataset "$DATASET"
