#!/bin/bash
# TERRA zero-shot embeddings + shared clustering/scoring for one dataset (GPU).
# Submit from this folder (logs and config are resolved relative to it):
#   DATASET=xhs1000-39b_1p bsub -q gpu -n 12 -M 128GB \
#       -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]" \
#       -gpu "num=1:gmem=40G:mode=exclusive_process" -W 12:00 < run_terra.lsf
# Needs a >= 40 GB GPU (batch size 128 runs out of memory on 16 GB cards).
# Optional: EXTRA_ARGS="--subsample 3000" for a smoke test, "--preprocess hvg" for TERRA + HVG.
#
#BSUB -G team361
#BSUB -J human_niche_terra
#BSUB -o ../../../artifacts/benchmarking/human/logs/terra_%J.out
#BSUB -e ../../../artifacts/benchmarking/human/logs/terra_%J.err
set -euo pipefail
: "${DATASET:?Set DATASET, e.g. DATASET=xhs1000-39b_1p}"
EXTRA_ARGS=${EXTRA_ARGS:-}
source "$LS_SUBCWD/config.sh"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-12}

echo "Host: $(hostname) | Job: $LSB_JOBID | Dataset: $DATASET | Extra: $EXTRA_ARGS"
nvidia-smi --query-gpu=name,memory.total --format=csv
"$BENCH_DIR/job_wrapper.sh" "$PYTHON_TERRA" run_terra.py --dataset "$DATASET" $EXTRA_ARGS
