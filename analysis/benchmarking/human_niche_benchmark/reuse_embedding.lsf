#!/bin/bash
# Score an embedding saved in a finished result as its own method
# (reuse_embedding.py), one array element per dataset. Defaults: TERRA-96M's
# cell embedding as terra_cell_emb. Submit from this folder:
#   bsub < reuse_embedding.lsf
#   SOURCE=terra EMB_KEY=cell_emb METHOD=terra_cell_emb bsub < reuse_embedding.lsf
#   METHOD=terra_cell_emb_nbavg EXTRA_ARGS=--neighbour_average bsub < reuse_embedding.lsf
#
#BSUB -G team361                                                                  # LSF group
#BSUB -J human_niche_reuse_emb[1-4]                                               # Array job: one per dataset
#BSUB -o ../../../artifacts/benchmarking/human/logs/reuse_emb_%J_%I.out           # Standard output
#BSUB -e ../../../artifacts/benchmarking/human/logs/reuse_emb_%J_%I.err           # Standard error
#BSUB -q normal                                                                   # Queue name
#BSUB -n 8                                                                        # Number of CPU cores
#BSUB -M 128GB                                                                    # Memory (largest dataset)
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                      # Reserve memory on one host
#BSUB -W 12:00                                                                    # Walltime (hh:mm)
set -euo pipefail
source "$LS_SUBCWD/config.sh"

DATASETS=(xhs1000-39b_1p xhs49-1b_1p chr78-11b_1p chl59-8b_1p)
DATASET=${DATASETS[$((LSB_JOBINDEX - 1))]}
SOURCE=${SOURCE:-terra}
EMB_KEY=${EMB_KEY:-cell_emb}
METHOD=${METHOD:-terra_cell_emb}
EXTRA_ARGS=${EXTRA_ARGS:-}

echo "Host: $(hostname) | Job: $LSB_JOBID[$LSB_JOBINDEX] | $SOURCE/$EMB_KEY -> $METHOD | Dataset: $DATASET"
"$BENCH_DIR/job_wrapper.sh" "$PYTHON_BANKSY" reuse_embedding.py \
    --source "$SOURCE" --emb_key "$EMB_KEY" --method "$METHOD" --dataset "$DATASET" $EXTRA_ARGS
