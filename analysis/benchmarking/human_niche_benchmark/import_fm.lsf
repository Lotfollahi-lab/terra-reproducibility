#!/bin/bash
# Import an existing foundation-model embedding (novae, scgpt-spatial,
# nicheformer, cellplm); job_wrapper.sh then scores it with score.py.
# Submit from this folder (logs and config are resolved relative to it):
#   METHOD=novae DATASET=xhs1000-39b_1p bsub -q normal -n 8 -M 64GB \
#       -R "select[mem>64GB] rusage[mem=64GB] span[hosts=1]" -W 12:00 < import_fm.lsf
#
#BSUB -G team361
#BSUB -J human_niche_import_fm
#BSUB -o ../../../artifacts/benchmarking/human/logs/import_fm_%J.out
#BSUB -e ../../../artifacts/benchmarking/human/logs/import_fm_%J.err
set -euo pipefail
: "${METHOD:?Set METHOD (novae | scgpt-spatial | nicheformer | cellplm)}"
: "${DATASET:?Set DATASET}"
source "$LS_SUBCWD/config.sh"

echo "Host: $(hostname) | Job: $LSB_JOBID | Method: $METHOD | Dataset: $DATASET"
"$BENCH_DIR/job_wrapper.sh" "$PYTHON_BANKSY" import_fm.py --method "$METHOD" --dataset "$DATASET"
