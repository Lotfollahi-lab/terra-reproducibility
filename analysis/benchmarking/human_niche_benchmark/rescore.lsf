#!/bin/bash
# Re-cluster and re-score a saved embedding (terra, banksy, neigh_expr_pca,
# cellcharter, nichecompass) with the current protocol; no re-embedding.
# Submit from this folder (logs and config are resolved relative to it):
#   METHOD=terra DATASET=chr78-11b_1p bsub -q normal -n 8 -M 48GB \
#       -R "select[mem>48GB] rusage[mem=48GB] span[hosts=1]" -W 12:00 < rescore.lsf
#
#BSUB -G team361
#BSUB -J human_niche_rescore
#BSUB -o ../../../artifacts/benchmarking/human/logs/rescore_%J.out
#BSUB -e ../../../artifacts/benchmarking/human/logs/rescore_%J.err
set -euo pipefail
: "${METHOD:?Set METHOD}"
: "${DATASET:?Set DATASET}"
source "$LS_SUBCWD/config.sh"
export OMP_NUM_THREADS=1   # parallelism comes from the resolution-scan workers

echo "Host: $(hostname) | Job: $LSB_JOBID | Method: $METHOD | Dataset: $DATASET"
"$BENCH_DIR/job_wrapper.sh" "$PYTHON_BANKSY" rescore.py --method "$METHOD" --dataset "$DATASET"
