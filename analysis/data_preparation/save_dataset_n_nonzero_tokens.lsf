#!/bin/bash
#BSUB -G team361
#BSUB -J save_dataset_n_nonzero_tokens                                                                     # Job name
#BSUB -o ../../logs/data_preparation/save_dataset_n_nonzero_tokens/save_dataset_n_nonzero_tokens_%J.out    # Standard output (%J = job ID)
#BSUB -e ../../logs/data_preparation/save_dataset_n_nonzero_tokens/save_dataset_n_nonzero_tokens_%J.err    # Standard error
#BSUB -q long                                                                                              # Queue name (CPU only)
#BSUB -n 2                                                                                                 # Number of CPU cores (the script is single-threaded)
#BSUB -M 128GB                                                                                             # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                                               # Resource requirements: reserve 128GB RAM on a single host
#BSUB -W 24:00                                                                                             # Walltime (hh:mm)

# n_nonzero_tokens lists (per-cell lengths for the length-grouped sampler) of the
# hst_corpus_110m corpus, for the splits written by split_dataset.lsf (run it first)
# and for the full index, written to $TOK.
#
# For the compact corpus (storage_format compact) use save_layout_n_nonzero_tokens.lsf
# instead: it writes one list per layout a model reads (e.g. 10 x 256 of the stored
# 16 x 512), which TERRA accepts, while it refuses these lists for a model that reads
# fewer neighbours or genes than stored. Without a list, TERRA derives the lengths at
# start-up from every corpus row (about 2 h 50 min on Lustre, in every rank). Keep
# this job for padded corpora (where the lists must match the layout read).
# Submit from this folder; the logs directory must exist first:
#   mkdir -p ../../logs/data_preparation/save_dataset_n_nonzero_tokens && bsub < save_dataset_n_nonzero_tokens.lsf

D=/lustre/scratch126/cellgen/lotfollahi/DATASETS
TOK="$D/tokenizer"
C="$D/gold/cell-graph-tokenizer/hst_corpus_110m/hst_corpus_110m_32_None_None_None_None_None_shifted_log_knn_16_8704.dataset"

# Load your environment
source /nfs/team361/sb75/.venvs/terra/bin/activate
set -e

# Run your Python script
python save_dataset_n_nonzero_tokens.py \
    --tokenizer_folder_path "$TOK" \
    --tokenized_data_folder_path "$C" \
    --cohort_name 'hst_corpus_110m'

python save_dataset_n_nonzero_tokens.py \
    --tokenizer_folder_path "$TOK" \
    --tokenized_data_folder_path "$C" \
    --cohort_name 'hst_corpus_110m' \
    --full_dataset
