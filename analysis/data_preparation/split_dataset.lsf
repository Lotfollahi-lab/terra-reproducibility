#!/bin/bash
#BSUB -G team361
#BSUB -J split_dataset                                                     # Job name
#BSUB -o ../../logs/data_preparation/split_dataset/split_dataset_%J.out    # Standard output (%J = job ID)
#BSUB -e ../../logs/data_preparation/split_dataset/split_dataset_%J.err    # Standard error
#BSUB -q long                                                              # Queue name (CPU only)
#BSUB -n 2                                                                 # Number of CPU cores (the script is single-threaded)
#BSUB -M 128GB                                                             # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"               # Resource requirements: reserve 128GB RAM on a single host
#BSUB -W 24:00                                                             # Walltime (hh:mm)

# Precomputed splits of the hst_corpus_110m corpus (16 neighbours x 512 genes,
# compact rows), written to $TOK (the folder TERRA configs read as
# ${TERRA_DATA_DIR}/tokenizer):
#   1. train / validation / test: the held-out batches of heldout_batch_ids.py
#      (the script's defaults); the train file records the excluded batch ids;
#   2. the full index (--full_dataset).
# Only the cell_id column is read, so the row format (padded or compact) and the
# row width do not matter. Memory: the cell ids as Python strings and the index
# lists (about 20 GB for 110M cells).
# Submit from this folder; the logs directory must exist first:
#   mkdir -p ../../logs/data_preparation/split_dataset && bsub < split_dataset.lsf

D=/lustre/scratch126/cellgen/lotfollahi/DATASETS
TOK="$D/tokenizer"
C="$D/gold/cell-graph-tokenizer/hst_corpus_110m/hst_corpus_110m_32_None_None_None_None_None_shifted_log_knn_16_8704.dataset"

# Load your environment
source /nfs/team361/sb75/.venvs/terra/bin/activate
set -e

# Run your Python script
python split_dataset.py \
    --tokenizer_folder_path "$TOK" \
    --tokenized_data_folder_path "$C" \
    --cohort_name 'hst_corpus_110m'

python split_dataset.py \
    --tokenizer_folder_path "$TOK" \
    --tokenized_data_folder_path "$C" \
    --cohort_name 'hst_corpus_110m' \
    --full_dataset
