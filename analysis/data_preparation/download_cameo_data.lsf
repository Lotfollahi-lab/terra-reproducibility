#!/bin/bash
#BSUB -G team361
#BSUB -J download_cameo_data                                                                            # Job name
#BSUB -o ../../logs/data_preparation/download_cameo_data/download_cameo_data_%J.out                     # Standard output (%J = job ID)
#BSUB -e ../../logs/data_preparation/download_cameo_data/download_cameo_data_%J.err                     # Standard error
#BSUB -q normal                                                                                         # Queue name
#BSUB -n 4                                                                                              # Number of CPU cores (parallel file downloads)
#BSUB -M 16GB                                                                                           # Memory
#BSUB -R "select[mem>16GB] rusage[mem=16GB] span[hosts=1]"                                              # Resource requirements
#BSUB -W 12:00                                                                                          # Walltime (hh:mm)

# The repositories are gated: store your Hugging Face token once on the head node first
# (python download_cameo_data.py --login); the job reads it from the Hugging Face token file (or HF_TOKEN).

# Load your environment
source /nfs/team361/sb75/.venvs/terra/bin/activate

# Run the Python script (unbuffered so that download progress shows up in the log)
python -u download_cameo_data.py \
    --output_directory_path '/nfs/team361/sb75/DATASETS/bronze/cameo' \
    --max_workers 4
