#!/bin/bash
#BSUB -G team361
#BSUB -J filter_cells_stratified_by_tissue_[1-4]                                                                      # Job array (4 jobs)
#BSUB -o ../../logs/data_preparation/filter_cells_stratified_by_tissue/filter_cells_stratified_by_tissue_%J_%I.out    # Standard output (%I = array index)
#BSUB -e ../../logs/data_preparation/filter_cells_stratified_by_tissue/filter_cells_stratified_by_tissue_%J_%I.err    # Standard error
#BSUB -q inference                                                                                                    # Queue name
#BSUB -n 12                                                                                                           # Number of CPU cores
#BSUB -M 128GB                                                                                                        # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                                                          # Resource requirements
#BSUB -W 48:00                                                                                                        # Walltime (hh:mm)
#BSUB -gpu "num=1:mode=exclusive_process"                                                                             # Request 1 GPU

# Load your environment
source ~/.venvs/nichejepa/bin/activate

# Define the list of sample ratios
ratios=(0.01 0.1 0.25 0.5)

# Get the ratio for this job index
RATIO=${ratios[$((LSB_JOBINDEX-1))]}

# Run the Python script
python filter_cells_stratified_by_tissue.py \
    --sample_ratios "$RATIO" \
    --dataset_path '/lustre/scratch126/cellgen/lotfollahi/DATASETS/gold/cell-graph-tokenizer/hst_corpus_110m/hst_corpus_110m_32_None_None_None_None_None_shifted_log_knn_10.dataset' \
    --train_idx_path '/lustre/scratch126/cellgen/lotfollahi/DATASETS/tokenizer/hst_corpus_110m_32_None_None_None_None_None_shifted_log_knn_10_precomputed_split_train.pkl' \
    --dataset_split_path '/nfs/team361/sb75/nichejepa-reproducibility/analysis/data_preparation/hst_corpus_110m/hst_corpus_110m_dataset_split.txt' \
    --cohort_name 'hst_corpus_110m' \
