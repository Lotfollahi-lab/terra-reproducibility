#!/bin/bash
#BSUB -G team361
#BSUB -J download_spatialfusion_data                                                                    # Job name
#BSUB -o ../../logs/data_preparation/download_spatialfusion_data/download_spatialfusion_data_%J.out     # Standard output (%J = job ID)
#BSUB -e ../../logs/data_preparation/download_spatialfusion_data/download_spatialfusion_data_%J.err     # Standard error
#BSUB -q normal                                                                                         # Queue name
#BSUB -n 1                                                                                              # Number of CPU cores
#BSUB -M 16GB                                                                                           # Memory
#BSUB -R "select[mem>16GB] rusage[mem=16GB] span[hosts=1]"                                              # Resource requirements
#BSUB -W 4:00                                                                                           # Walltime (hh:mm)

# Load your environment
source ~/.venvs/terra/bin/activate

# Run the Python script (unbuffered so that download progress shows up in the log)
python -u download_spatialfusion_data.py \
    --output_directory_path '/nfs/team361/sb75/DATASETS/bronze/spatialfusion'
