#!/bin/bash
#BSUB -G s10396                                                                        # LSF group (cost code)
#BSUB -J terra_inference_efficiency                                                    # Job name
#BSUB -o ../../logs/inference_efficiency/run_efficiency/run_efficiency_%J.out          # Standard output (%J = job ID)
#BSUB -e ../../logs/inference_efficiency/run_efficiency/run_efficiency_%J.err          # Standard error
#BSUB -q inference                                                                     # Queue name
#BSUB -n 12                                                                            # CPU cores (DataLoader workers)
#BSUB -M 128GB                                                                         # Memory (prepare_data reads the whole H5AD)
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                          # Reserve 128GB RAM on a single host
#BSUB -W 12:00                                                                         # Walltime (hh:mm)
#BSUB -gpu "num=1:mode=exclusive_process"                                              # One GPU to ourselves (timings)

# Submit from analysis/inference_efficiency/ after setup_variants.sh, e.g.
#   mkdir -p ../../logs/inference_efficiency/run_efficiency
#   H5AD=/path/to/sample.h5ad bsub < run_efficiency.lsf
# LSF forwards the submission environment (H5AD, WORK, MODELS, N_CELLS,
# SAMPLE_KEY, SAMPLE, BATCH_SIZE, NUM_WORKERS, REPS, TOK_NPROCS,
# SKIP_TOKENIZATION) to the job.

source /nfs/team361/sb75/.venvs/terra/bin/activate

bash run_efficiency.sh
