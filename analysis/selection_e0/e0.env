# Parameters of the E0 headroom experiment (analysis/selection_e0/README.md). Plain bash assignments: setup_code.sh
# and submit_data_step.sh take this file as their first argument.

# Pinned TERRA code of every E0 job (setup_code.sh): Lotfollahi-lab/terra exp/effective-exposures (index-list
# sampling, exposure logging, add_spatial_index), copied to CODE_PATH; the jobs put its src/ first on PYTHONPATH, so
# changes of the farm checkout (the venv's editable install) cannot change them. ENV_PATH is the venv that runs it.
COMMIT="49b4840c44354937b713cbfa2be5bb939d14193c"
CODE_PATH="/nfs/team361/sb75/terra_e0"
ENV_PATH="/nfs/team361/sb75/.venvs/terra"

# Data: the corpus silver datasets, and the proxy's name (its silver folder, tokenizer config and gold folder:
# config/cell-graph-tokenizer/cell-graph-tokenizer_${PROXY_NAME}.yaml)
DATA_DIRECTORY_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS"
CORPUS_NAMES_FILE="analysis/data_preparation/hst_corpus_110m/hst_corpus_110m_dataset_names.txt"  # in the checkout
PROXY_NAME="hst_corpus_110m_e0_proxy"
# The proxy's tokenized dataset (create_tokenized_dataset.py's name for the config's settings)
PROXY_DATASET_PATH="${DATA_DIRECTORY_PATH}/gold/cell-graph-tokenizer/${PROXY_NAME}/${PROXY_NAME}_32_None_None_None_None_None_shifted_log_knn_16_8704.dataset"

# Selection (select_proxy.py)
N_BATCHES=48
MAX_CELLS=100000
MIN_CELLS=5000
SELECTION_SEED=0

# Index lists (build_index_lists.py): epochs of every run (the budget C is N_EPOCHS passes over the proxy)
N_EPOCHS=6

# Outputs: proxy/ (manifests), index_lists/
ARTIFACT_FOLDER_PATH="/nfs/team361/sb75/terra-reproducibility/artifacts/e0"

# LSF of the CPU steps, as the corpus tokenization jobs (wrapper_create_cell_graph_tokenized_dataset.sh): submit them
# from the CPU farm. TOKENIZE_*: the proxy's tokenization job (size the memory with tokenization_memory.py; README).
LSF_GROUP_CPU="team361"
CPU_QUEUE="normal"
TOKENIZE_QUEUE="long"
TOKENIZE_CORES=4
TOKENIZE_RAM="400G"
TOKENIZE_WALLTIME="48:00"
