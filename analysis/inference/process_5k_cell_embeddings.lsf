# Load your environment
source /etc/profile.d/modules.sh
module load cellgen/conda
conda activate /nfs/team361/sb75/ENVS/rapids-singlecell

# Run your Python script
python process_5k_cell_embeddings.py \
    --cohort_name 'hst_corpus_110m' \
    --load_timestamp '11012026_190057_836' \
    --read_checkpoint 'terra-ep0.pth.tar' \
    --use_rapids \
    --n_pcs 50
