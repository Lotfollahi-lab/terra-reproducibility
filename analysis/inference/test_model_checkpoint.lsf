#!/bin/bash
#BSUB -G team361                                                                    # LSF group
#BSUB -J test_model_checkpoint                                                      # Job name
#BSUB -o ../../logs/inference/test_model_checkpoint/test_model_checkpoint_%J.out    # Standard output (%J = job ID)
#BSUB -e ../../logs/inference/test_model_checkpoint/test_model_checkpoint_%J.err    # Standard error
#BSUB -q gpu-lotfollahi                                                             # Queue name
#BSUB -n 12                                                                         # Number of CPU cores
#BSUB -M 128GB                                                                      # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                        # Resource requirements: reserve 128GB RAM on a single host
#BSUB -W 120:00                                                                     # Walltime (hh:mm)
#BSUB -gpu "num=1:mode=exclusive_process"                                           # Request 1 GPU

# Load your environment
source ~/.venvs/nichejepa/bin/activate

# Run your Python script
python test_model_checkpoint.py \
    --load_timestamp 18092025_140643_921 \
    --read_checkpoint nichejepa-ep4.pth.tar \
    --no-include_xhs49 \
    --no-include_xhs1000 \
    --no-include_xhk1007 \
    --include_xhb1002 \
    --include_chl59 \
    --include_chr78  

