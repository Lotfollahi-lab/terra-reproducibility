#!/bin/bash
#BSUB -G team361
#BSUB -J get_5k_cell_embeddings                                                          # Job name
#BSUB -o ../../logs/inference/get_5k_cell_embeddings/get_5k_cell_embeddings_%J.out       # Standard output (%J = job ID)
#BSUB -e ../../logs/inference/get_5k_cell_embeddings/get_5k_cell_embeddings_%J.err       # Standard error
#BSUB -q inference                                                                       # Queue name
#BSUB -n 12                                                                              # Number of CPU cores
#BSUB -M 128GB                                                                           # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                             # Resource requirements: reserve 256GB RAM on a single host
#BSUB -W 48:00                                                                           # Walltime (hh:mm)
#BSUB -gpu "num=1:mode=exclusive_process"                                                # Request 1 GPU

# Load your environment
source ~/.venvs/terra/bin/activate

# Run your Python script
python get_5k_cell_embeddings.py \
    --cohort_name 'hst_corpus_110m' \
    --load_timestamp '19122025_101304_096' \
    --read_checkpoint 'terra-ep2.pth.tar' \
    --start_step 90 \
    --end_step 99
