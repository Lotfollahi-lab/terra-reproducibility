#!/bin/bash
#BSUB -G team361
#BSUB -J get_5k_tissue_clusters                                                         # Job name
#BSUB -o ../../logs/inference/get_5k_tissue_clusters/get_5k_tissue_clusters_%J.out      # Standard output (%J = job ID)
#BSUB -e ../../logs/inference/get_5k_tissue_clusters/get_5k_tissue_clusters_%J.err      # Standard error
#BSUB -q inference                                                                      # Queue name
#BSUB -n 12                                                                             # Number of CPU cores
#BSUB -M 512GB                                                                          # Memory
#BSUB -R "select[mem>512GB] rusage[mem=512GB] span[hosts=1]"                            # Resource requirements: reserve 1000GB RAM on a single host
#BSUB -W 48:00                                                                          # Walltime (hh:mm)  
#BSUB -gpu "num=1:mode=exclusive_process"     

# Load your environment
source /etc/profile.d/modules.sh
module load cellgen/conda
conda activate /nfs/team361/sb75/ENVS/rapids-singlecell

# Run your Python script
python get_5k_tissue_clusters.py \
    --cohort_name 'hst_corpus_110m' \
    --load_timestamp '07112025_054432_709' \
    --read_checkpoint 'nichejepa-ep3.pth.tar' \
    --n_pcs 50
