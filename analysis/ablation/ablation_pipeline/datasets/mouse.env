# Ablation parameters of the mouse sections of the original ablations (rerun first): MERFISH (mouse brain, batch82) and
# STARmap PLUS (mouse CNS, batch15), coordinate-aligned, with their region annotations as ground truth. Plain bash
# assignments: the submit scripts and setup_code.sh take this file as their first argument; for the interactive steps,
# `source` it and pass the values as in README.md ("Mouse rerun"). Lists are space-separated.

# Dataset: the two section files of the silver folder that the mouse base config trains on (base_config.yaml,
# tokenized_data_folder_path), one per section (MERFISH and STARmap PLUS; written by stjepa-reproducibility's
# mouse_brain_align_coords.ipynb; check the names with ls). filter_silver_cells.py (README.md, Mouse rerun, step 3)
# writes them without the cells that have no detected gene of the mouse token dictionary to the dataset's own silver
# folder, silver/DATASET_NAME, which then holds exactly these two files (the tokenizer reads every h5ad file of its
# folder); the source files are not modified.
SOURCE_DATASET_NAME="mmb0-1b_smb1-1b_2p_coord_aligned"
DATASET_NAME="${SOURCE_DATASET_NAME}_nonempty"
EXPERIMENT_TAG="mouse"  # wandb run ids: <EXPERIMENT_TAG>_<manifest index>_<config hash>
DATA_DIRECTORY_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS"
SOURCE_SILVER_FILE_PATHS="${DATA_DIRECTORY_PATH}/silver/${SOURCE_DATASET_NAME}/harmonised_merfish_mouse_brain_239-batch_batch82.h5ad ${DATA_DIRECTORY_PATH}/silver/${SOURCE_DATASET_NAME}/harmonised_starmap_plus_mouse_cns_batch15.h5ad"
# All h5ad files of the dataset's silver folder (the filtered files), sorted; computed when this file is sourced, so
# empty until filter_silver_cells.py has run; check_setup.py prints them
SILVER_FILE_PATHS="$(find "${DATA_DIRECTORY_PATH}/silver/${DATASET_NAME}" -maxdepth 1 -name '*.h5ad' 2>/dev/null \
    | LC_ALL=C sort | paste -sd ' ' - || true)"
TOKEN_DICTIONARY_FILE_PATH="${DATA_DIRECTORY_PATH}/tokenizer/token_dictionary_mus_musculus.pkl"
# New file: the factors of the two filtered sections with the tokenizer's constants (compute_norm_factors.py; README.md,
# Mouse rerun, step 3)
NORM_FACTOR_FILE_PATH="${DATA_DIRECTORY_PATH}/tokenizer/${DATASET_NAME}_norm_factors.csv"

# Evaluation: the region annotation of each section (MERFISH: ccf_region_name, STARmap PLUS:
# Sub_molecular_tissue_region; the mouse evaluation scored both) and the label of unannotated cells
LABEL_KEYS="ccf_region_name Sub_molecular_tissue_region"
# PLACEHOLDER: set it to the value of unannotated cells from the value counts of check_setup.py (README.md, Mouse rerun,
# step 5) and regenerate. One value for both keys, or one per key as <key>=<value> pairs separated by ';', e.g.
# "ccf_region_name=unassigned;Sub_molecular_tissue_region=Unassigned" (no commas needed). A value that occurs in no file
# scores every labelled cell of its key, as the mouse evaluation did.
UNASSIGNED_LABEL="PLACEHOLDER_SET_FROM_CHECK_SETUP"
# Optional: label files with obs['cell_id'] and the label keys, one per section, if the silver files lack the region
# keys (default: the silver files; check_setup.py checks that they cover the tokenized cells). E.g. the evaluation
# files of the mouse notebook (stjepa_v2_ablation.ipynb):
# LABEL_FILE_PATHS="${DATA_DIRECTORY_PATH}/silver/mmb0-1b_smb1-1b_1p_coord_aligned/harmonised_merfish_mouse_brain_239-batch_batch82_shared_genes.h5ad ${DATA_DIRECTORY_PATH}/silver/mmb0-1b_smb1-1b_1p_coord_aligned/harmonised_starmap_plus_mouse_cns_batch15_shared_genes.h5ad"
# Evaluation data: shared_genes embeds the same cells restricted to the genes measured in both sections, as the published
# mouse evaluation did (MERFISH and STARmap PLUS have different panels, so with all_genes the integration metrics would
# partly measure panel identity). filter_shared_genes.py writes them to silver/${DATASET_NAME}_shared_genes (without
# cells with fewer than 10 detected shared genes); submit_tokenization.sh tokenizes them with every tokenization of the
# plan, the token dictionary and the factor file of training.
EVAL_GENE_SET="shared_genes"

# Runs: the mouse schedule (300 epochs with 3 warmup epochs; 722 iterations per epoch on 4 GPUs) and the
# n_special_values of the mouse configs (check_setup.py checks that the batch special values fit)
ARTIFACT_FOLDER_PATH="/nfs/team361/sb75/terra-reproducibility/artifacts/mouse_ablation"
EPOCHS=300
WARMUP=3
N_SPECIAL_VALUES=200
PLAN_FILE_PATH="/nfs/team361/sb75/terra-reproducibility/analysis/ablation/ablation_pipeline/ablation_plan.yaml"
BASE_CONFIG_FILE_PATH="/nfs/team361/sb75/terra-reproducibility/analysis/ablation/ablation_pipeline/base_config.yaml"

# Pinned TERRA code (setup_code.sh; shared by all datasets) and the TERRA environment that runs it
CODE_PATH="/nfs/team361/sb75/terra_ablation"
ENV_PATH="/nfs/team361/sb75/.venvs/terra"

# Mouse runs, for the checks against them (check_setup.py, check_mouse_norm_factors.py)
MOUSE_ARTIFACT_FOLDER_PATH="/nfs/team361/sb75/stjepa-reproducibility/artifacts"
MOUSE_TOKEN_DICTIONARY_FILE_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS/tokenizer/token_dictionary_mus_musculus.pkl"
