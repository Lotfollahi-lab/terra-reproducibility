# Ablation parameters of the SpatialFusion Xenium Prime 5K ovarian cancer section (OVCA), with its pathologist niche
# labels as ground truth. Plain bash assignments: the submit scripts and setup_code.sh take this file as their first
# argument; for the interactive steps, `source` it and pass the values as in README.md. Lists are space-separated.

# Dataset
DATASET_NAME="xho50-1b_1p_spatialfusion"
EXPERIMENT_TAG="ovca"  # wandb run ids: <EXPERIMENT_TAG>_<manifest index>_<config hash>
DATA_DIRECTORY_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS"
SILVER_FILE_PATHS="/lustre/scratch126/cellgen/lotfollahi/DATASETS/silver/xho50-1b_1p_spatialfusion/xho50-1b_1p_spatialfusion_batch0.h5ad"
TOKEN_DICTIONARY_FILE_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS/tokenizer/token_dictionary_homo_sapiens.pkl"
NORM_FACTOR_FILE_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS/tokenizer/xho50-1b_1p_spatialfusion_norm_factors.csv"

# Evaluation: niche labels (obs keys of the silver files) and the label of cells outside annotated regions
LABEL_KEYS="path_region"
UNASSIGNED_LABEL="Unassigned"

# Runs: 82 epochs with 1 warmup epoch match the 300 / 3 epochs of the mouse runs in optimizer steps (OVCA has 3.66x
# their iterations per epoch); n_special_values must cover the human batch special value (about 213)
ARTIFACT_FOLDER_PATH="/nfs/team361/sb75/terra-reproducibility/artifacts/ovca_ablation"
EPOCHS=82
WARMUP=1
N_SPECIAL_VALUES=1448
PLAN_FILE_PATH="/nfs/team361/sb75/terra-reproducibility/analysis/ablation/ablation_pipeline/ablation_plan.yaml"
BASE_CONFIG_FILE_PATH="/nfs/team361/sb75/terra-reproducibility/analysis/ablation/ablation_pipeline/base_config.yaml"

# Pinned code (setup_code.sh) and the environment that runs it
CODE_PATH="/nfs/team361/sb75/stjepa_ablation"
ENV_PATH="/nfs/team361/sb75/.venvs/stjepa_v2"

# Mouse runs, for the checks against them (check_setup.py, check_mouse_norm_factors.py)
MOUSE_ARTIFACT_FOLDER_PATH="/nfs/team361/sb75/stjepa-reproducibility/artifacts"
MOUSE_TOKEN_DICTIONARY_FILE_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS/tokenizer/token_dictionary_mus_musculus.pkl"

# OVCA data preparation only (prepare_ovca_data.lsf)
BRONZE_FILE_PATH="/nfs/team361/sb75/DATASETS/bronze/spatialfusion/benchmark_processed_data/processed_OVCA.h5ad"
GENE_MAPPING_DICT_FILE_PATH="/lustre/scratch126/cellgen/lotfollahi/DATASETS/genes/homo_sapiens_gene_name_to_ensembl_id_dict.pkl"
