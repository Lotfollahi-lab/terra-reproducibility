#!/bin/bash
# OVCA data preparation (prepare_ovca_data.py): silver AnnData, normalization factors and token dictionary checks. Takes
# the dataset's env file through bsub -env; submit from this directory:
#   mkdir -p ../../../logs/ablation/ovca_ablation
#   bsub -env "all,DATASET_ENV_FILE_PATH=datasets/ovca.env" < prepare_ovca_data.lsf
#BSUB -G team361
#BSUB -J prepare_ovca_data                                                             # Job name
#BSUB -o ../../../logs/ablation/ovca_ablation/prepare_ovca_data_%J.out                 # Standard output (%J = job ID)
#BSUB -e ../../../logs/ablation/ovca_ablation/prepare_ovca_data_%J.err                 # Standard error
#BSUB -q normal                                                                        # Queue name
#BSUB -n 1                                                                             # Number of CPU cores
#BSUB -M 64GB                                                                          # Memory
#BSUB -R "select[mem>64GB] rusage[mem=64GB] span[hosts=1]"                             # Resource requirements
#BSUB -W 4:00                                                                          # Walltime (hh:mm)

set -euo pipefail

if [ -z "${DATASET_ENV_FILE_PATH:-}" ] || [ ! -f "${DATASET_ENV_FILE_PATH}" ]; then
    echo "ERROR: pass the env file: bsub -env \"all,DATASET_ENV_FILE_PATH=datasets/ovca.env\" < prepare_ovca_data.lsf" >&2
    exit 1
fi
source "${DATASET_ENV_FILE_PATH}"
read -r -a SILVER_FILE_PATH_LIST <<< "${SILVER_FILE_PATHS}"
if [ "${#SILVER_FILE_PATH_LIST[@]}" -ne 1 ]; then
    echo "ERROR: the OVCA data preparation writes one silver file, but SILVER_FILE_PATHS lists" \
         "${#SILVER_FILE_PATH_LIST[@]}." >&2
    exit 1
fi

# TERRA environment (harmonize_bronze_to_silver.py dependencies) with the pinned TERRA code (the tokenizer's normalizer
# for the factors; setup_code.sh)
set +u
source "${ENV_PATH}/bin/activate"
set -u
export PYTHONPATH="${CODE_PATH}/src${PYTHONPATH:+:${PYTHONPATH}}"

# Run the Python script
python -u prepare_ovca_data.py --bronze_file_path "${BRONZE_FILE_PATH}" \
    --silver_file_path "${SILVER_FILE_PATH_LIST[0]}" --norm_factor_file_path "${NORM_FACTOR_FILE_PATH}" \
    --gene_mapping_dict_file_path "${GENE_MAPPING_DICT_FILE_PATH}" \
    --token_dictionary_file_path "${TOKEN_DICTIONARY_FILE_PATH}"
