#!/bin/bash
# Ablations: one job array element trains (or resumes) the run of manifest.tsv row LSB_JOBINDEX on 4 GPUs with the
# launch setup of the mouse ablations (bsub_script.sh and train_model_lsf_mpirun_sanger.sh, as in TERRA's scripts/),
# then packages and evaluates it. Submit with submit_ablation_array.sh <env file> from this directory, which sets the
# job name, array indices, concurrency (2 elements = 8 GPUs) and log files, and passes ARTIFACT_FOLDER_PATH and
# ENV_PATH through bsub -env. The campaign's dataset values (dataset, silver and label files, label keys, norm factors,
# wandb tag, pinned code and its version) come from ${ARTIFACT_FOLDER_PATH}/dataset.env, written by
# generate_ablation_runs.py.
#BSUB -G team361
#BSUB -q training-parallel
#BSUB -n 32
#BSUB -gpu "num=4:gmem=40000:mode=exclusive_process:block=yes"
#BSUB -M 128G
#BSUB -R "select[mem>128G] rusage[mem=128G] span[ptile=32]"

set -euo pipefail

if [ -z "${ARTIFACT_FOLDER_PATH:-}" ] || [ -z "${ENV_PATH:-}" ]; then
    echo "ERROR: ARTIFACT_FOLDER_PATH and ENV_PATH must be set; submit with submit_ablation_array.sh <env file>." >&2
    exit 1
fi
DATASET_ENV_FILE_PATH="${ARTIFACT_FOLDER_PATH}/dataset.env"
MANIFEST_FILE_PATH="${ARTIFACT_FOLDER_PATH}/manifest.tsv"
for FILE_PATH in "${DATASET_ENV_FILE_PATH}" "${MANIFEST_FILE_PATH}"; do
    if [ ! -f "${FILE_PATH}" ]; then
        echo "ERROR: ${FILE_PATH} does not exist; run generate_ablation_runs.py first." >&2
        exit 1
    fi
done
# DATASET_NAME, SILVER_FILE_PATHS, LABEL_FILE_PATHS, LABEL_KEYS, UNASSIGNED_LABEL, NORM_FACTOR_FILE_PATH,
# EXPERIMENT_TAG, CODE_PATH, CODE_VERSION
source "${DATASET_ENV_FILE_PATH}"
# dataset.env written before LABEL_FILE_PATHS existed: the labels are in the silver files
LABEL_FILE_PATHS="${LABEL_FILE_PATHS:-${SILVER_FILE_PATHS}}"
ADVANCED_BASH_SCRIPT_PATH="/software/isg/advanced-bsub-script"

# The configs were generated for the pinned code at CODE_PATH; stop if it has another version
if [ "$(cat "${CODE_PATH}/CODE_VERSION" 2>/dev/null)" != "${CODE_VERSION}" ]; then
    echo "ERROR: ${CODE_PATH}/CODE_VERSION ($(cat "${CODE_PATH}/CODE_VERSION" 2>/dev/null || echo missing)) differs" \
         "from the code version of the configs (${CODE_VERSION}); set up that code version or regenerate the configs." >&2
    exit 1
fi

# Run of this array element: manifest row LSB_JOBINDEX, with the columns written by generate_ablation_runs.py
MANIFEST_COLUMNS="index run_id run_name variant category label replicate seed code_version config_file_path"
MANIFEST_COLUMNS="${MANIFEST_COLUMNS} run_folder_path eval_folder_path"
if [ "$(head -n 1 "${MANIFEST_FILE_PATH}" | tr '\t' ' ')" != "${MANIFEST_COLUMNS}" ]; then
    echo "ERROR: the columns of ${MANIFEST_FILE_PATH} are not '${MANIFEST_COLUMNS}'; regenerate it with" \
         "generate_ablation_runs.py." >&2
    exit 1
fi
ROWS=$(awk -F'\t' -v idx="${LSB_JOBINDEX}" 'NR > 1 && $1 == idx' "${MANIFEST_FILE_PATH}")
N_ROWS=$(printf '%s' "${ROWS}" | grep -c '^' || true)
if [ "${N_ROWS}" -ne 1 ]; then
    echo "ERROR: ${MANIFEST_FILE_PATH} has ${N_ROWS} rows with index ${LSB_JOBINDEX} (expected 1); check the array" \
         "indices against the manifest." >&2
    exit 1
fi
N_FIELDS=$(printf '%s\n' "${ROWS}" | awk -F'\t' '{ print NF }')
N_EMPTY_FIELDS=$(printf '%s\n' "${ROWS}" | awk -F'\t' '{ n = 0; for (i = 1; i <= NF; i++) if ($i == "") n++; print n }')
read -r -a COLUMN_NAMES <<< "${MANIFEST_COLUMNS}"
N_COLUMNS="${#COLUMN_NAMES[@]}"
if [ "${N_FIELDS}" -ne "${N_COLUMNS}" ] || [ "${N_EMPTY_FIELDS}" -ne 0 ]; then
    echo "ERROR: manifest row ${LSB_JOBINDEX} has ${N_FIELDS} tab-separated fields (${N_EMPTY_FIELDS} empty);" \
         "expected ${N_COLUMNS} non-empty fields. Regenerate the manifest with generate_ablation_runs.py." >&2
    exit 1
fi
IFS=$'\t' read -r INDEX RUN_ID PLAN_RUN_NAME VARIANT CATEGORY LABEL REPLICATE SEED RUN_CODE_VERSION CONFIG_FILE \
    RUN_FOLDER_PATH EVAL_FOLDER_PATH <<< "${ROWS}"
echo "Run ${INDEX}: ${RUN_ID} (${CATEGORY}: ${LABEL}; replicate ${REPLICATE}, seed ${SEED}; ${PLAN_RUN_NAME})"
if [ "${RUN_CODE_VERSION}" != "${CODE_VERSION}" ]; then
    echo "ERROR: manifest row ${INDEX} has code version '${RUN_CODE_VERSION}', dataset.env '${CODE_VERSION}';" \
         "regenerate the configs." >&2
    exit 1
fi
CONFIG_HASH="${RUN_ID##*_}"
if ! [[ "${CONFIG_HASH}" =~ ^[0-9a-f]{8}$ ]]; then
    echo "ERROR: run id ${RUN_ID} does not end with an 8-digit config hash." >&2
    exit 1
fi
# Done if evaluate_ablation_run.py recorded the campaign's labels in evaluation_complete. It writes the file last, once
# every metatoken mode has its metrics (with two or more label files, i.e. sections, also the batch-integration
# metrics); files written before the batch-integration metrics existed lack the label_file_paths line, so those runs
# are evaluated again.
EVALUATION_COMPLETE_FILE_PATH="${EVAL_FOLDER_PATH}/evaluation_complete"
if [ -f "${EVALUATION_COMPLETE_FILE_PATH}" ] \
    && grep -qxF "label_keys: ${LABEL_KEYS}" "${EVALUATION_COMPLETE_FILE_PATH}" \
    && grep -qxF "label_file_paths: ${LABEL_FILE_PATHS}" "${EVALUATION_COMPLETE_FILE_PATH}" \
    && grep -qxF "unassigned_label: ${UNASSIGNED_LABEL}" "${EVALUATION_COMPLETE_FILE_PATH}"; then
    echo "Already trained and evaluated (label keys: ${LABEL_KEYS}; label files: ${LABEL_FILE_PATHS})."
    exit 0
fi

# Environment as in bsub_script.sh (single node, 4 GPUs, one MPI rank per GPU). wandb: main.py uses the run id
# ${EXPERIMENT_NAME}_${RUN_NAME} = <tag>_<manifest index>_<config hash> (e.g. ovca_042_1a2b3c4d) and WANDB_NAME, the
# descriptive run id, as the display name
export CONFIG_FILE
export EXPERIMENT_NAME="${EXPERIMENT_TAG}"
RUN_NAME="$(printf '%03d' "${INDEX}")_${CONFIG_HASH}"
export RUN_NAME
export WANDB_NAME="${RUN_ID}"
export BACKEND="nccl"
export TRAINING_SCRIPT_PATH="${CODE_PATH}/src/terra/training/main.py"
export NUM_NODES=1 NUM_GPUS_NODE=4 NUM_PROCESSES_NODE=32 TOTAL_NUM_GPUS=4 TOTAL_NUM_CORES=32
export NCCL_IB_DISABLE=1
export OUTPUT_DIR="${RUN_FOLDER_PATH}"
export LOG_DIR="${ARTIFACT_FOLDER_PATH}/logs"
export NCCL_DEBUG=INFO
export NCCL_TOPO_DUMP_FILE="${LOG_DIR}/nccl_topo_dump-${LSB_JOBID}_${LSB_JOBINDEX}.xml"
export NCCL_DEBUG_FILE="${LOG_DIR}/nccl_debug-${LSB_JOBID}_${LSB_JOBINDEX}.log"
export TORCH_CPP_LOG_LEVEL="INFO"
# numba (kNN of the evaluation) compiles for a generic CPU, so the graph does not depend on the node
export NUMBA_CPU_NAME=generic
. "${ADVANCED_BASH_SCRIPT_PATH}/nccl_setup.sh"
unset LSB_AFFINITY_HOSTFILE
. /usr/share/modules/init/sh
module load ISG/experimental/fg12/openmpi/5.0.4-cuda12.1-lsf
source "${ADVANCED_BASH_SCRIPT_PATH}/check_and_load_cuda.sh"
check_and_load_cuda
source "${ENV_PATH}/bin/activate"
# The venv's editable install points at the farm checkout, which may change; use the pinned code
export PYTHONPATH="${CODE_PATH}/src${PYTHONPATH:+:${PYTHONPATH}}"
python3 -c "import terra; assert terra.__file__.startswith('${CODE_PATH}/'), terra.__file__"
. "${ADVANCED_BASH_SCRIPT_PATH}/find_master_port.sh"
. "${ADVANCED_BASH_SCRIPT_PATH}/build_mpi_host_string.sh"
# find_master_port.sh derives the port from the job ID, which all array elements share
MASTER_PORT=$(python3 -c 'import socket; s = socket.socket(); s.bind(("", 0)); print(s.getsockname()[1])')
export MASTER_PORT

# Train unless finished (the run config resumes from terra-latest.pth.tar if it exists). Exit code 3 means not
# finished; any other failure (e.g. an unreadable checkpoint) stops here instead of silently retraining from scratch.
set +e
python3 package_run.py --run_folder_path "${RUN_FOLDER_PATH}" --norm_factor_file_path "${NORM_FACTOR_FILE_PATH}" \
    --check_only
CHECK_STATUS=$?
set -e
if [ "${CHECK_STATUS}" -eq 3 ]; then
    mkdir -p "${RUN_FOLDER_PATH}"
    # TERRA loads state.read_checkpoint whenever state.load_checkpoint is set and raises if it is missing: the launch
    # config resumes only if the run has a latest checkpoint (one that exists but cannot be loaded still raises)
    LAUNCH_CONFIG_FILE="${RUN_FOLDER_PATH}/launch_config.yaml"
    python3 - "${CONFIG_FILE}" "${LAUNCH_CONFIG_FILE}" <<'PY'
import sys
from pathlib import Path

import yaml

config = yaml.safe_load(open(sys.argv[1]))
latest_checkpoint_path = Path(config["state"]["folder_path"]) / config["state"]["read_checkpoint"]
config["state"]["load_checkpoint"] = latest_checkpoint_path.is_file()
print(f"{'Resuming from' if latest_checkpoint_path.is_file() else 'Training from scratch; no'} {latest_checkpoint_path}")
with open(sys.argv[2], "w") as file:
    yaml.safe_dump(config, file, sort_keys=False)
PY
    export CONFIG_FILE="${LAUNCH_CONFIG_FILE}"
    "${CODE_PATH}/scripts/train_model_lsf_mpirun_sanger.sh"
elif [ "${CHECK_STATUS}" -ne 0 ]; then
    echo "Could not check ${RUN_FOLDER_PATH} (exit code ${CHECK_STATUS}); inspect it before resubmitting."
    exit 1
fi

# Package (fails if training did not finish) and evaluate (lists are space-separated, hence unquoted)
python3 package_run.py --run_folder_path "${RUN_FOLDER_PATH}" --norm_factor_file_path "${NORM_FACTOR_FILE_PATH}"
# shellcheck disable=SC2086
python3 -u evaluate_ablation_run.py --model_folder_path "${RUN_FOLDER_PATH}" --output_folder_path "${EVAL_FOLDER_PATH}" \
    --dataset_name "${DATASET_NAME}" --label_file_paths ${LABEL_FILE_PATHS} --label_keys ${LABEL_KEYS} \
    --unassigned_label "${UNASSIGNED_LABEL}"
