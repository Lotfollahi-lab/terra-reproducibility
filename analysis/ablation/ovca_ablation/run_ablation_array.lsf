#!/bin/bash
# OVCA ablations: one job array element trains (or resumes) the run of manifest.tsv row LSB_JOBINDEX on 4 GPUs with the
# launch setup of the mouse ablations (bsub_script.sh and train_model_lsf_mpirun_sanger.sh of sebastianbirk/stjepa),
# then packages and evaluates it. Submit with submit_ablation_array.sh from this directory, which sets the job name,
# array indices, concurrency (2 elements = 8 GPUs) and log files.
#BSUB -G team361
#BSUB -q training-parallel
#BSUB -n 32
#BSUB -gpu "num=4:gmem=40000:mode=exclusive_process:block=yes"
#BSUB -M 128G
#BSUB -R "select[mem>128G] rusage[mem=128G] span[ptile=32]"

set -euo pipefail

ARTIFACT_FOLDER_PATH="${ARTIFACT_FOLDER_PATH:-/nfs/team361/sb75/terra-reproducibility/artifacts/ovca_ablation}"
CODE_PATH="${CODE_PATH:-/nfs/team361/sb75/stjepa_ovca_ablation}"  # pinned stjepa v2 (b433d5e) + seed patch
ENV_PATH="${ENV_PATH:-/nfs/team361/sb75/.venvs/stjepa_v2}"
ADVANCED_BASH_SCRIPT_PATH="/software/isg/advanced-bsub-script"

# Run of this array element (RUN_ID = run name + config hash; also the wandb run name)
IFS=$'\t' read -r INDEX RUN_ID RUN_NAME VARIANT CATEGORY LABEL REPLICATE SEED EXPERIMENT_NAME CONFIG_FILE \
    RUN_FOLDER_PATH EVAL_FOLDER_PATH \
    < <(awk -F'\t' -v idx="${LSB_JOBINDEX}" 'NR > 1 && $1 == idx' "${ARTIFACT_FOLDER_PATH}/manifest.tsv")
echo "Run ${INDEX}: ${RUN_ID} (${CATEGORY}: ${LABEL}; replicate ${REPLICATE}, seed ${SEED})"
if [ -f "${EVAL_FOLDER_PATH}/xho50-1b_1p_spatialfusion_neighborhood_emb_niche_identification_metrics_res_sweep.csv" ]; then
    echo "Already trained and evaluated."
    exit 0
fi

# Environment as in bsub_script.sh (single node, 4 GPUs, one MPI rank per GPU)
export EXPERIMENT_NAME CONFIG_FILE
export RUN_NAME="${RUN_ID}"
export BACKEND="nccl"
export TRAINING_SCRIPT_PATH="${CODE_PATH}/src/app/training/main.py"
export NUM_NODES=1 NUM_GPUS_NODE=4 NUM_PROCESSES_NODE=32 TOTAL_NUM_GPUS=4 TOTAL_NUM_CORES=32
export NCCL_IB_DISABLE=1
export OUTPUT_DIR="${RUN_FOLDER_PATH}"
export LOG_DIR="${ARTIFACT_FOLDER_PATH}/logs"
export NCCL_DEBUG=INFO
export NCCL_TOPO_DUMP_FILE="${LOG_DIR}/nccl_topo_dump-${LSB_JOBID}_${LSB_JOBINDEX}.xml"
export NCCL_DEBUG_FILE="${LOG_DIR}/nccl_debug-${LSB_JOBID}_${LSB_JOBINDEX}.log"
export TORCH_CPP_LOG_LEVEL="INFO"
. "${ADVANCED_BASH_SCRIPT_PATH}/nccl_setup.sh"
unset LSB_AFFINITY_HOSTFILE
. /usr/share/modules/init/sh
module load ISG/experimental/fg12/openmpi/5.0.4-cuda12.1-lsf
source "${ADVANCED_BASH_SCRIPT_PATH}/check_and_load_cuda.sh"
check_and_load_cuda
source "${ENV_PATH}/bin/activate"
# The venv's editable install points at the farm checkout, which may change; use the pinned code
export PYTHONPATH="${CODE_PATH}/src${PYTHONPATH:+:${PYTHONPATH}}"
python3 -c "import app.utils, stjepa; assert all(m.__file__.startswith('${CODE_PATH}/') for m in (app.utils, stjepa)), (app.utils.__file__, stjepa.__file__)"
. "${ADVANCED_BASH_SCRIPT_PATH}/find_master_port.sh"
. "${ADVANCED_BASH_SCRIPT_PATH}/build_mpi_host_string.sh"
# find_master_port.sh derives the port from the job ID, which all array elements share
MASTER_PORT=$(python3 -c 'import socket; s = socket.socket(); s.bind(("", 0)); print(s.getsockname()[1])')
export MASTER_PORT

# Train unless finished (the run config resumes from stjepa-latest.pth.tar if it exists). Exit code 3 means not
# finished; any other failure (e.g. an unreadable checkpoint) stops here instead of silently retraining from scratch.
set +e
python3 package_run.py --run_folder_path "${RUN_FOLDER_PATH}" --check_only
CHECK_STATUS=$?
set -e
if [ "${CHECK_STATUS}" -eq 3 ]; then
    mkdir -p "${RUN_FOLDER_PATH}"
    "${CODE_PATH}/src/app/training/train_model_lsf_mpirun_sanger.sh"
elif [ "${CHECK_STATUS}" -ne 0 ]; then
    echo "Could not check ${RUN_FOLDER_PATH} (exit code ${CHECK_STATUS}); inspect it before resubmitting."
    exit 1
fi

# Package (fails if training did not finish) and evaluate
python3 package_run.py --run_folder_path "${RUN_FOLDER_PATH}"
python3 -u evaluate_ablation_run.py --model_folder_path "${RUN_FOLDER_PATH}" --output_folder_path "${EVAL_FOLDER_PATH}"
