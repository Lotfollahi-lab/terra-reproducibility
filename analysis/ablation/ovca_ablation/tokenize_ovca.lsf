#!/bin/bash
# OVCA ablations: one job array element creates the tokenized dataset LSB_JOBINDEX of the ablation plan with the pinned
# ST-JEPA v2 tokenizer. Submit with submit_tokenization.sh from this directory (queue, memory, indices and logs).
#BSUB -G team361
#BSUB -n 12

set -euo pipefail

CODE_PATH="${CODE_PATH:-/nfs/team361/sb75/stjepa_ovca_ablation}"  # pinned stjepa v2 (b433d5e) + seed patch
ENV_PATH="${ENV_PATH:-/nfs/team361/sb75/.venvs/stjepa_v2}"

source "${ENV_PATH}/bin/activate"
export PYTHONPATH="${CODE_PATH}/src${PYTHONPATH:+:${PYTHONPATH}}"

python -u tokenize_ovca.py --tokenization_index "${LSB_JOBINDEX}"
