+def order_gene_tokens(gene_scores: np.ndarray,
+                      gene_tokens: np.ndarray,
+                      tie_break_values: np.ndarray,
+                      count_values: np.ndarray | None = None,
+                      ) -> np.ndarray:
+    """
+    Order genes by a gene-level key: gene score (descending), count value
+    (descending, optional), tie-break value (ascending) and gene token
+    (ascending). Gene tokens are unique, so the key is a total order on
+    genes and the result depends neither on the order of the genes nor on
+    the sort algorithm. NaN values are ordered last on every key.
+
+    Parameters
+    ----------
+    gene_scores:
+        1D vector containing gene scores (normalized gene expression of
+        the rank stream).
+    gene_tokens:
+        1D vector containing gene tokens.
+    tie_break_values:
+        1D vector containing per-gene tie-break values (e.g. the reference
+        nonzero mean expression, so that the less expressed gene is
+        ranked first).
+    count_values:
+        1D vector containing the normalized gene expression of the count
+        stream (secondary key).
+
+    Returns
+    ----------
+    order:
+        1D vector containing the indices that order the genes.
+    """
+    # np.lexsort sorts by the last key first; negate (exactly, in float64)
+    # for descending keys
+    keys = [np.asarray(gene_tokens),
+            np.asarray(tie_break_values, dtype=np.float64)]
+    if count_values is not None:
+        keys.append(-np.asarray(count_values, dtype=np.float64))
+    keys.append(-np.asarray(gene_scores, dtype=np.float64))
+    order = np.lexsort(keys)
+
+    return order
