+def get_spv_token_offset(token_dict: dict) -> int | None:
+    """
+    Token id offset of special values (token id = special value + offset),
+    as used by the tokenizers to store special values
+    (`spv_start_idx - 2 - max_cls_tokens`). Returns `None` if the token
+    dictionary has no special value tokens.
+    """
+    spv_token_ids = [
+        token_id for key, token_id in token_dict.items()
+        if str(key).startswith('spv_')]
+    if not spv_token_ids:
+        return None
+    max_cls_tokens = sum(1 for key in token_dict if 'cls' in str(key))
+    spv_token_offset = min(spv_token_ids) - 2 - max_cls_tokens
+    hard_coded_offset = 1674 if len(token_dict) == 2785 else 21957
+    if spv_token_offset != hard_coded_offset:
+        print(f"WARNING: special value token offset {spv_token_offset} of the "
+              f"token dictionary differs from the hard-coded offset "
+              f"{hard_coded_offset}; using {spv_token_offset} for "
+              f"`gt_type: rank`.")
+    return spv_token_offset
