#BSUB -e ../../logs/tokenization/reorder_dataset/reorder_dataset_%J.err    # Standard error
#BSUB -q teramem                                                              # Queue name
#BSUB -n 64                                                                # Number of CPU cores
#BSUB -M 756GB                                                             # Memory
#BSUB -R "select[mem>756GB] rusage[mem=756GB] span[hosts=1]"               # Resource requirements: reserve 756GB RAM on a single host
#BSUB -W 48:00                                                             # Walltime (hh:mm)

# Load your environment
source ~/.venvs/nichejepa/bin/activate

# Run your Python script
python reorder_dataset.py \
    --dataset_path '/lustre/scratch126/cellgen/lotfollahi/DATASETS/gold/cell-graph-tokenizer/hst_corpus_90m/hst_corpus_90m_32_None_None_None_None_None_shifted_log_knn_10.dataset' \
