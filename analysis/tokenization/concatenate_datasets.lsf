#!/bin/bash
#BSUB -G team361
#BSUB -J concatenate_datasets                                                         # Job name
#BSUB -o ../../logs/tokenization/concatenate_datasets/concatenate_datasets_%J.out     # Standard output (%J = job ID)
#BSUB -e ../../logs/tokenization/concatenate_datasets/concatenate_datasets_%J.err     # Standard error
#BSUB -q hugemem                                                                      # Queue name
#BSUB -n 12                                                                           # Number of CPU cores
#BSUB -M 256GB                                                                        # Memory
