#!/bin/bash
#BSUB -G team361
#BSUB -J concatenate_datasets                                                         # Job name
#BSUB -o ../../logs/tokenization/concatenate_datasets/concatenate_datasets_%J.out     # Standard output (%J = job ID)
#BSUB -e ../../logs/tokenization/concatenate_datasets/concatenate_datasets_%J.err     # Standard error
#BSUB -q long                                                                         # Queue name (CPU only)
#BSUB -n 12                                                                           # Number of CPU cores
#BSUB -M 256GB                                                                        # Memory
#BSUB -R "select[mem>256GB] rusage[mem=256GB] span[hosts=1]"                          # Resource requirements: reserve 256GB RAM on a single host
#BSUB -W 48:00                                                                        # Walltime (hh:mm)

# Concatenate the 158 per-dataset parts of hst_corpus_110m (16 neighbours x 512
# genes per cell, model_input_size 8704, compact rows: storage_format compact)
# into
#   $D/gold/cell-graph-tokenizer/hst_corpus_110m/hst_corpus_110m_32_None_None_None_None_None_shifted_log_knn_16_8704.dataset
# with the parts' terra_tokenizer_params.json. Before the save, the script refuses
# parts without a settings record (e.g. a tokenization job killed after writing the
# rows: rm -rf the part and re-tokenize it), parts with different settings records,
# parts that are not compact (or whose record contradicts their columns), and
# missing or duplicated cell ids. The corpus is written to <corpus>.partial-<job id>
# and renamed into place once complete; a killed run leaves only that folder
# (nothing reads it: delete it). An existing corpus is refused: add --overwrite
# to replace it (disk space for both corpora is needed until the swap).
# The parts are memory-mapped; the cell-id check holds a copy of the cell ids and
# a hash table in memory (about 12-15 GB for 112.6M ids).
# --num_proc writes the corpus shards in parallel (same rows, same order).
# Submit from this folder; the logs directory must exist first:
#   mkdir -p ../../logs/tokenization/concatenate_datasets && bsub < concatenate_datasets.lsf

D=/lustre/scratch126/cellgen/lotfollahi/DATASETS
R=/nfs/team361/sb75/terra-reproducibility

# Load your environment (TERRA feat/compact-tokenized-data: reads compact rows)
source /nfs/team361/sb75/.venvs/terra/bin/activate

# Run your Python script
python concatenate_datasets.py \
    --data_directory_path "$D" \
    --cohort_name 'hst_corpus_110m' \
    --cohort_dataset_names_file_path "$R/analysis/data_preparation/hst_corpus_110m/hst_corpus_110m_dataset_names.txt" \
    --n_neighs 16 \
    --seq_len 8704 \
    --expect_storage_format compact \
    --num_proc 12
