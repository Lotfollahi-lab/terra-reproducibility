   "source": [
    "# Load data\n",
    "if n_batches == 1:\n",
    "    adata = sc.read_h5ad(f\"{st_data_silver_folder_path}/{dataset_name}/{dataset_name}.h5ad\")\n",
    "else:\n",
    "    adata = sc.read_h5ad(f\"{st_data_silver_folder_path}/{dataset_name}/{dataset_name}_batch1.h5ad\")"
   ]
  },
  {
   "cell_type": "code",
