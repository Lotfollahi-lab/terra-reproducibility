    "tokenized_data_folder_path = f\"{st_data_gold_folder_path}/{tokenizer}/{dataset_name}/{output_file_prefix}.dataset\"\n",
    "dataset = load_from_disk(tokenized_data_folder_path, keep_in_memory=True)\n",
