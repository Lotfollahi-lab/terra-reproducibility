    "\n",
    "print(dataset[f\"top_{top_n}_neighbor_cell_tokens\"][0])\n",
    "print(\"\")\n",
    "print(dataset[f\"top_{top_n}_index_cell_tokens\"][0])\n",
    "print(\"\")"
   ]
