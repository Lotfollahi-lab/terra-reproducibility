   "source": [
    "# Test classification token retrieval\n",
    "top_n = 10\n",
    "model_input_size = n_gene_tokens * min(16, max_neighbors) # 512\n",
    "\n",
    "norm_method = \"shifted_log\"\n",
    "norm_factor = \"read_depth\" # \"read_depth\", \"cell_area\"\n",
