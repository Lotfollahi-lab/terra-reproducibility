#!/bin/bash
#BSUB -G s10396                                                                        # LSF group
#BSUB -J xhs1000-39b_1p_analysis                                                       # Job name
#BSUB -o ../../logs/analysis/xhs1000-39b_1p_analysis/xhs1000-39b_1p_analysis_%J.out    # Standard output (%J = job ID)
#BSUB -e ../../logs/analysis/xhs1000-39b_1p_analysis/xhs1000-39b_1p_analysis_%J.err    # Standard error
#BSUB -q inference                                                                     # Queue name
#BSUB -n 12                                                                            # Number of CPU cores
#BSUB -M 128GB                                                                         # Memory
#BSUB -R "select[mem>128GB] rusage[mem=128GB] span[hosts=1]"                           # Reserve 128GB RAM on a single host
#BSUB -W 48:00                                                                         # Walltime (hh:mm)
#BSUB -gpu "num=1:mode=exclusive_process"                                              # Request 1 GPU (model inference + rapids)

# Non-interactive matplotlib backend (plots are saved to disk).
export MPLBACKEND=Agg

# Load the terra-rapids environment (rapids_singlecell + GPU).
source /nfs/team361/sb75/.venvs/terra-rapids/bin/activate

# Run the analysis (submit this job from analysis/data_analysis/ so the script's
# relative paths, e.g. sys.path.append("../../utils"), resolve).
#
# Pick the model run per submission via MODEL_TIMESTAMP / CHECKPOINT env vars
# (LSF forwards the submission environment to the job), e.g.:
#   MODEL_TIMESTAMP=24062026_143932_756 CHECKPOINT=terra-ep19.pth.tar \
#       bsub < xhs1000-39b_1p_analysis.lsf
# The values below are the defaults used when those vars are not set.
python xhs1000-39b_1p_analysis.py \
    --model_timestamp "${MODEL_TIMESTAMP:-24062026_143538_479}" \
    --checkpoint "${CHECKPOINT:-terra-ep49.pth.tar}"
