# LSBATCH: User input
#!/bin/bash
#BSUB -G team361                                                                    # LSF group
#BSUB -J test_model_checkpoint[1-6]                                                 # Array job: 6 jobs (one per dataset)
#BSUB -o ../../logs/inference/test_model_checkpoint/test_model_checkpoint_%J.out    # Standard output (%J = job ID)
