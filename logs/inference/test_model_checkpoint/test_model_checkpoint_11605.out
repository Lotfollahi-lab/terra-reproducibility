dataset=${datasets[$((LSB_JOBINDEX-1))]}

# Run your Python script
python test_model_checkpoint.py \
    --cohort_name hst_corpus_110m \
    --load_timestamp 25102025_174845_488 \
    --read_checkpoint nichejepa-ep2.pth.tar \
    "$dataset"  


