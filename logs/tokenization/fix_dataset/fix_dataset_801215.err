   "source": [
    "# Set dataset params\n",
    "batch_key = 'batch'\n",
    "emb_key = 'cell'\n",
    "latent_leiden_resolution = 0.3\n",
    "spot_sizes = [0.3, 30]\n",
    "\n",
    "latent_cluster_key = f'{emb_key}_emb_leiden_res{str(latent_leiden_resolution).replace(\".\", \"_\")}'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "id": "b04ac8f1-0cc3-4be2-a57f-9ff85849a27c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute UMAP representation for (aggregated) gene embeddings\n",
    "if F'{emb_key}_connectivities' not in adata.obsp.keys():\n",
    "    print(\"Computing sc.pp.neighbors...\")\n",
    "    sc.pp.neighbors(adata,\n",
    "                    n_neighbors=15,\n",
    "                    use_rep=f'{emb_key}_emb_layer_{layer}',\n",
    "                    key_added=emb_key)\n",
    "if f'{emb_key}_umap' not in adata.obsm.keys():\n",
    "    print(\"Computing sc.tl.umap...\")\n",
    "    sc.tl.umap(adata,\n",
    "               neighbors_key=emb_key,\n",
    "               key_added=f'{emb_key}_umap')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 61,
   "id": "3cb4dde6-1210-451a-bbf0-289b05595de9",
   "metadata": {},
   "outputs": [],
   "source": [
    "sc.tl.leiden(adata,\n",
    "             neighbors_key=emb_key,\n",
    "             key_added=latent_cluster_key,\n",
    "             resolution=latent_leiden_resolution)"
   ]
  },
