  {
   "cell_type": "markdown",
   "id": "0cc5a297-1ca2-423a-a6aa-80c8a5d17959",
   "metadata": {},
   "source": [
    "#### 2.1.13 New Spatial Score "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b125de62-aa1c-4416-a1e4-65435474ba7c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#define cell_gene_ensembl_id and neighborhood_gene_ensembl_id here for example\n",
    "cell_gene_ensembl_id=['ENSG00000104689','ENSG00000204301','ENSG00000161638','ENSG00000148400',\n",
    "                      'ENSG00000074181','ENSG00000120156', 'ENSG00000066056', 'ENSG00000105810',\n",
    "                      'ENSG00000037280','ENSG00000146648','ENSG00000173578']\n",
    "\n",
    "cell_gene_ensembl_id=['ENSG00000186810','ENSG00000089692','ENSG00000188389','ENSG00000135077',\n",
    "                      'ENSG00000161638']\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dd7bb094-0ddb-4c2e-aab8-6587c0fd5cf0",
   "metadata": {},
   "outputs": [],
   "source": [
    "emb_layer = None\n",
    "batch_size = 128\n",
    "pin_memory = False\n",
    "num_workers = 12\n",
    "agg_excluded_tokens = None\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dbd4c08f-fe6d-41b0-be2b-68561868831e",
   "metadata": {},
   "outputs": [],
   "source": [
    "top_k = None\n",
    "#dataset=dataset.select(range(2000))\n",
    "result= average_receptor_embedding( dataset=dataset,\n",
    "    model_folder_path=model_folder_path,\n",
    "    emb_layer=emb_layer,\n",
    "    batch_size=batch_size,\n",
    "    pin_memory=pin_memory,\n",
    "    num_workers=num_workers,\n",
    "    cell_gene_ensembl_id=cell_gene_ensembl_id,\n",
    "    neighborhood_gene_ensembl_id=neighborhood_gene_ensembl_id\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2421593c-3455-4a13-9172-63f5d9c20324",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_similarity_df(data, target_gene1):\n",
    "    records = []\n",
    "\n",
    "    # Step 1: collect all gene2s for this gene1\n",
    "    gene2_set = {\n",
    "        gene2 for (gene1, gene2, status) in data if gene1 == target_gene1\n",
    "    }\n",
    "\n",
    "    # Step 2: for each gene2, check if both 'present' and 'absent' exist\n",
    "    for gene2 in gene2_set:\n",
    "        key_present = (target_gene1, gene2, 'present')\n",
    "        key_absent = (target_gene1, gene2, 'absent')\n",
    "\n",
    "        if key_present in data and key_absent in data:\n",
    "            vec_present = np.array(data[key_present]['average'])\n",
    "            vec_absent = np.array(data[key_absent]['average'])\n",
    "\n",
    "            # Compute cosine similarity\n",
    "            sim = cosine_similarity(vec_present.reshape(1, -1), vec_absent.reshape(1, -1))[0][0]\n",
    "\n",
    "            # Get counts, or default to 1 if missing\n",
    "            count_present = data[key_present].get('count', 1)\n",
    "            count_absent = data[key_absent].get('count', 1)\n",
    "\n",
    "            records.append({\n",
    "                'gene1': target_gene1,\n",
    "                'gene2': gene2,\n",
    "                'cosine_similarity': sim,\n",
    "                'count_present': count_present,\n",
    "                'count_absent': count_absent,\n",
    "                 'count_sum': count_absent + count_present,\n",
    "\n",
    "            })\n",
    "\n",
    "    # Convert to DataFrame\n",
    "    return pd.DataFrame(records)\n",
    "\n",
    "def summarize_gene_expression(\n",
    "    adata,\n",
    "    subset_cell_ids: list,\n",
    "    top_n: int = 10,\n",
    "    ensembl_col: str = \"ensembl_id\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Filter AnnData to a subset of cells, compute gene expression summaries,\n",
    "    and return top expressed genes with Ensembl IDs.\n",
    "\n",
    "    Args:\n",
    "        adata (AnnData): Pre-loaded AnnData object.\n",
    "        subset_cell_ids (list): List of cell IDs to filter.\n",
    "        top_n (int): Number of top expressed genes to return.\n",
    "        ensembl_col (str): Column in adata.var that contains Ensembl IDs.\n",
    "\n",
    "    Returns:\n",
    "        combined_counts (pd.DataFrame): Filtered cell-by-gene count matrix.\n",
    "        top_gene_df (pd.DataFrame): DataFrame with top gene names and Ensembl IDs.\n",
    "    \"\"\"\n",
    "    if 'cell_id' not in adata.obs.columns:\n",
    "        raise KeyError(\"Expected `adata.obs` to contain a 'cell_id' column.\")\n",
    "    if ensembl_col not in adata.var.columns:\n",
    "        raise KeyError(f\"Expected `adata.var` to contain '{ensembl_col}' column.\")\n",
    "\n",
    "    # Filter to subset of cells\n",
    "    mask = adata.obs['cell_id'].astype(str).isin(set(subset_cell_ids))\n",
    "    filtered = adata[mask].copy()\n",
    "    if filtered.n_obs == 0:\n",
    "        raise ValueError(\"No matching cells found in the provided subset.\")\n",
    "\n",
    "    # Extract dense matrix\n",
    "    matrix = filtered.X.toarray() if hasattr(filtered.X, \"toarray\") else filtered.X\n",
    "    combined_counts = pd.DataFrame(matrix, columns=filtered.var_names, index=filtered.obs_names)\n",
    "\n",
    "    # Compute mean expression and get top N genes\n",
    "    mean_expr = combined_counts.mean(axis=0)\n",
    "    top_genes = mean_expr.nlargest(top_n)\n",
    "\n",
    "    # Map to Ensembl IDs\n",
    "    var_df = adata.var.loc[top_genes.index]\n",
    "    top_gene_df = pd.DataFrame({\n",
    "        \"gene_name\": top_genes.index,\n",
    "        \"ensembl_id\": var_df[ensembl_col].values,\n",
    "        \"mean_expression\": top_genes.values\n",
    "    })\n",
    "\n",
    "    return combined_counts, top_gene_df\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3b2a9d05-3c56-4848-ac72-7ace857a277e",
   "metadata": {},
   "outputs": [],
   "source": [
    "similarities = compute_similarity_df(data, 'ENSG00000135077')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "927c8422-1afc-41eb-8648-1e64b07210cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "#put some threshold here\n",
    "tre = 100"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "08c5900d-0756-4f50-9f3a-638d966d979b",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_similarities_filter = df_similarities[(df_similarities['count_present'] > tre) & (df_similarities['count_absent'] > tre)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d31b458b-865d-44f4-9344-3a6fcb9d935f",
   "metadata": {},
   "outputs": [],
   "source": [
    "#look at distribution of this socre\n",
    "plt.hist(df_similarities_filter['cosine_similarity'], bins=30, edgecolor='black')\n",
    "plt.xlabel('Mean similarity')\n",
    "plt.ylabel('Frequency')\n",
    "plt.title('Histogram of mean similarities')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "77baad7f-88d0-465a-88e7-87f3988a639e",
   "metadata": {},
   "outputs": [],
   "source": [
    "#define mapping to gene_name\n",
    "id2gene = {v:k for k,v in adata.var['ensembl_id'].items()}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd9625a4-a94d-4661-830c-9128c618d65c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Get expression value in corpus\n",
    "combined_counts, top_gene_df = summarize_gene_expression(adata, list(adata.obs['cell_id']),top_n=5000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0a804782-1271-49fa-b652-74472785bd5f",
   "metadata": {},
   "outputs": [],
   "source": [
    "#map gene name\n",
    "df_similarities_filter['gene_name_ligand'] = df_similarities_filter['gene2'].map(id2gene)\n",
    "df_similarities_filter['gene_name_receptor'] = df_similarities_filter['gene1'].map(id2gene)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "467d0fc6-b0c0-41c9-b43b-7fd5c943c558",
   "metadata": {},
   "outputs": [],
   "source": [
    "#map expr value\n",
    "gene_to_expression = top_gene_df.set_index('gene_name')['mean_expression'].to_dict()\n",
    "top_gene_df[\"rank\"] = top_gene_df[\"mean_expression\"].rank(method=\"min\", ascending=False)\n",
    "expr_rank_map = top_gene_df.set_index(\"gene_name\")[\"rank\"]\n",
    "\n",
    "# Step 2: Map mean_expression to gene_name_ligand using the dictionary\n",
    "df_similarities_filter['mean_expression_ligand'] = df_similarities_filter['gene_name_ligand'].map(gene_to_expression)\n",
    "df_similarities_filter[\"rank_ligand\"] = df_similarities_filter[\"gene_name_ligand\"].map(expr_rank_map)\n",
    "\n",
    "df_similarities_filter['mean_expression_receptor'] = df_similarities_filter['gene_name_receptor'].map(gene_to_expression)\n",
    "df_similarities_filter[\"rank_receptor\"] = df_similarities_filter[\"gene_name_receptor\"].map(expr_rank_map)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2ad2ff98-56ca-40dc-a1d7-88311db187b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "#drop list \n",
    "df_similarities_filter = df_similarities_filter.reset_index(drop=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d56cc4cb-68ed-462c-bbba-f9cc95e8a8f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# print head item\n",
    "df_similarities_filter.head(30)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2a7fb405-9b86-407f-9c81-8207c260d458",
   "metadata": {
    "jp-MarkdownHeadingCollapsed": true
   },
   "source": [
    "#### 2.1.13 Perturbed Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "167abbaa-4685-43d6-afad-57661c9d3bf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define perturbations\n",
    "perturbed_cell_id = ['1007_batch20_0', '1007_batch20_0', '1007_batch20_1']\n",
    "perturbed_ensembl_id = ['all', 'all', 'ENSG00000169194'] # ['all'] * len(perturbed_cell_id)\n",
    "perturbation_target = ['cell', 'neighborhood', 'cell'] # ['neighborhood'] * len(perturbed_cell_id)\n",
    "perturbation_type = ['knockout', 'knockout', 'foldchange'] # ['knockout'] * len(perturbed_cell_id)\n",
    "foldchange = [np.nan, np.nan, 0.5] # [np.nan] * len(perturbed_cell_id)\n",
    "\n",
    "perturb_df =  pd.DataFrame({\n",
    "    'perturbed_cell_id': perturbed_cell_id,\n",
    "    'perturbed_ensembl_id': perturbed_ensembl_id,\n",
    "    'perturbation_target': perturbation_target,\n",
    "    'perturbation_type': perturbation_type, \n",
    "    'foldchange': foldchange\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "940b9f0e-e955-4e3e-b2a6-5516e139d8f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "perturbed_dataset = perturb_dataset(\n",
    "    dataset=dataset,\n",
    "    perturb_df=perturb_df,\n",
    "    model_folder_path=model_folder_path)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "64b7ab0e-c9f2-4c40-b9ca-d2c80ca5d070",
   "metadata": {
    "jp-MarkdownHeadingCollapsed": true
   },
   "source": [
    "#### 2.1.14 Embed Perturb Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0e053e0c-27a9-417a-9082-0716481553ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "perturbed_output_embed = embed_dataset(\n",
    "    dataset=perturbed_dataset,\n",
    "    model_folder_path=model_folder_path,\n",
    "    emb_layer=emb_layer,\n",
    "    cell_gene_ids=cell_gene_ids,\n",
    "    neighborhood_gene_ids=neighborhood_gene_ids,\n",
    "    agg_excluded_tokens=agg_excluded_tokens,\n",
    "    top_k=top_k,\n",
    "    batch_size=batch_size,\n",
    "    pin_memory=pin_memory,\n",
    "    num_workers=num_workers)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e5a496bb-28b5-4a14-b4ae-9107c03c5310",
   "metadata": {},
   "outputs": [],
   "source": [
    "adata.obsm['perturbed_cell_emb'] = perturbed_output_embed['cell_emb']\n",
    "adata.obsm['perturbed_neighborhood_emb'] = perturbed_output_embed['neighborhood_emb']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1b29efb0-0282-4624-979b-1cd5752de868",
   "metadata": {},
   "outputs": [],
   "source": [
    "label = cell_type_key\n",
    "\n",
    "# Neighborhood embedding UMAP\n",
    "sc.pp.neighbors(adata,\n",
    "                n_neighbors=15,\n",
    "                use_rep='perturbed_neighborhood_emb',\n",
    "                key_added='perturbed_neighborhood')\n",
    "sc.tl.umap(adata,\n",
    "           neighbors_key='perturbed_neighborhood',\n",
    "           key_added='perturbed_neighborhood_umap')\n",
    "adata.obsm['X_umap'] = adata.obsm['perturbed_neighborhood_umap']\n",
    "sc.pl.umap(adata,\n",
    "           neighbors_key='perturbed_neighborhood',\n",
    "           color=label)\n",
    "\n",
    "# Cell embedding UMAP\n",
    "sc.pp.neighbors(adata,\n",
    "                n_neighbors=15,\n",
    "                use_rep='perturbed_cell_emb',\n",
    "                key_added='perturbed_cell')\n",
    "sc.tl.umap(adata,\n",
    "           neighbors_key='perturbed_cell',\n",
    "           key_added='perturbed_cell_umap')\n",
    "adata.obsm['X_umap'] = adata.obsm['perturbed_cell_umap']\n",
    "sc.pl.umap(adata,\n",
    "           neighbors_key='perturbed_cell',\n",
    "           color=label)"
   ]
  }
 ],
